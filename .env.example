# OGZNSFW MVP configuration. Copy to .env (never commit .env).
# No provider = the app runs with honest "not configured" states. It never mocks.

# Server
PORT=3000
HOST=127.0.0.1

# Chat provider. Options: ollama
# (requires a pulled model: run `ollama pull <model>` first)
CHAT_PROVIDER=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Image provider. Options: comfyui (local, scene-capable) or huggingface (single-subject only)
IMAGE_PROVIDER=
# Required when IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# Required when IMAGE_PROVIDER=huggingface
HF_TOKEN=
HF_IMAGE_MODEL=

# Stripe: NOT WIRED in this MVP. Placeholder for the billing milestone.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
